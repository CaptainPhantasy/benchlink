# Benchlink Mac sidecar — env contract (0.2.0-mvp). Copy to .env (gitignored).
# Primary key. UNSET-UNTIL-PROVISIONED.
# Intended once Douglas clears Tailscale serve (Larry FYI; NOT live yet):
#   BENCHLINK_BRIDGE_BASE_URL=https://inference.tail58d565.ts.net:19740
# (client appends /v1). Do NOT call it from Computer smoke — HTTPS serve not ready.
# Demoted / wrong-tailnet (do not use): bridge.floyds-labs.ts.net
BENCHLINK_BRIDGE_BASE_URL=
# Optional pre-obtained short-lived bearer (D3). Normally leave unset: the sidecar pairs
# with the device key and re-pairs once on auth.expired. Never commit a real value.
BENCHLINK_ACCESS_TOKEN=
# D3 device key (Ed25519 PKCS8 PEM, 0600). Create with: python -m benchlink_sidecar generate-key
# Public half goes on the daemon allowlist out-of-band; private key never printed.
BENCHLINK_DEVICE_KEY_PATH=~/.config/benchlink/device_ed25519.pem
# Defaults to `hostname -s`
BENCHLINK_DEVICE_ID=
# Loopback Bridge Control stub
BENCHLINK_SIDECAR_LISTEN_HOST=127.0.0.1
BENCHLINK_SIDECAR_LISTEN_PORT=8787
# Optional TOML file (same keys under [bridge]/[sidecar])
BENCHLINK_SIDECAR_CONFIG=
# Only after live HTTPS serve on the intended host is confirmed
BENCHLINK_ALLOW_PLACEHOLDER_HOST=0
