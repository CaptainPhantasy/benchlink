# bridge-daemon (inference). Computer edit home; runtime later under
# /srv/organized/floyds-labs-staff/grok-app-floyd-bridge/
# NAMES ONLY — never commit values. Real values live in the inference host env (Claire / Douglas).
BENCHLINK_BRIDGE_LISTEN_HOST=127.0.0.1
BENCHLINK_BRIDGE_LISTEN_PORT=8790
# Optional public Tailscale URL — UNSET-UNTIL-PROVISIONED.
# Intended once Douglas clears Tailscale serve (Larry FYI; NOT live yet):
#   https://inference.tail58d565.ts.net:19740
# (clients append /v1). Do not call from Computer smoke.
# Demoted wrong-tailnet: bridge.floyds-labs.ts.net
BENCHLINK_BRIDGE_PUBLIC_BASE_URL=
BENCHLINK_ALLOW_PLACEHOLDER_HOST=0
BENCHLINK_LOG_LEVEL=INFO

# ---- D3 auth (Claire spec) ----
# Allowlist JSON {device_id: {public_key_b64url, tailscale_identity?, scopes?}} — outside the repo
BENCHLINK_DEVICE_ALLOWLIST_PATH=~/.config/benchlink/device_allowlist.json
# MUST be 1 in prod behind tailscale serve (Tailscale-User-Login header); 0 only for loopback tests.
# Paired nodes must be untagged, user-owned devices (no tag identity in MVP).
BENCHLINK_REQUIRE_TAILSCALE_IDENTITY=0
BENCHLINK_ACCESS_TTL_SECONDS=900

# ---- staff-adapter: transport ----
BENCHLINK_ADAPTER_TRANSPORT=webhook
# Per target (FLOYD default, ETHAN canary; others optional). Values = Grok Bot routine webhook + sender key.
BENCHLINK_TARGET_FLOYD_WEBHOOK_URL=
BENCHLINK_TARGET_FLOYD_SENDER_KEY=
BENCHLINK_TARGET_ETHAN_WEBHOOK_URL=
BENCHLINK_TARGET_ETHAN_SENDER_KEY=
# TBD: routine sender-key header convention unconfirmed -> default Authorization: Bearer <key>
BENCHLINK_WEBHOOK_SENDER_KEY_HEADER=Authorization
BENCHLINK_WEBHOOK_SENDER_KEY_SCHEME=Bearer
BENCHLINK_WEBHOOK_TIMEOUT_S=10
BENCHLINK_TASK_TIMEOUT_S=600

# ---- staff-adapter: result source (GM: default drive_folder) ----
BENCHLINK_RESULT_SOURCE=drive_folder
BENCHLINK_RESULTS_DRIVE_FOLDER_ID=
# Dedicated Drive service account JSON key (Claire). Outside the repo, chmod 600, rotate every 90 days.
# drive_folder mode refuses to start if missing or looser than 0600. Scope: drive.readonly.
BENCHLINK_DRIVE_SA_KEY_PATH=
BENCHLINK_RESULTS_POLL_INTERVAL_S=5
# local_folder (tests/smoke) and http_callback (future) only
BENCHLINK_RESULTS_LOCAL_DIR=
BENCHLINK_CALLBACK_BASE_URL=
BENCHLINK_CALLBACK_TOKEN_TTL_S=900
