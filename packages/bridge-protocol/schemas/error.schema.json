{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floydslabs.local/bridge/v1/error.schema.json",
  "title": "error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "code",
    "message",
    "retryable",
    "correlation_id"
  ],
  "properties": {
    "v": {
      "const": "1"
    },
    "type": {
      "const": "error"
    },
    "code": {
      "$ref": "common.schema.json#/$defs/errorClass"
    },
    "message": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "correlation_id": {
      "$ref": "common.schema.json#/$defs/uuidLike"
    }
  }
}
