{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floydslabs.local/bridge/v1/auth_pair_complete.schema.json",
  "title": "auth.pair.complete",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "device_id",
    "proof",
    "scopes"
  ],
  "properties": {
    "v": {
      "const": "1"
    },
    "type": {
      "const": "auth.pair.complete"
    },
    "device_id": {
      "type": "string"
    },
    "proof": {
      "type": "string",
      "minLength": 1
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "session.create",
          "session.message",
          "session.close",
          "task.create"
        ]
      }
    }
  }
}
